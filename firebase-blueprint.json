{
  "entities": {
    "SiteConfig": {
      "title": "Site Configuration",
      "description": "Comprehensive customizable content for all institutional advisory portal sections",
      "type": "object",
      "properties": {
        "noticeTicker": { "type": "string" },
        "breakingNotice": { "type": "string" },
        "breakingNoticeLink": { "type": "string" },
        "consultationHours": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroPill": { "type": "string" },
        "statYears": { "type": "string" },
        "statYearsLabel": { "type": "string" },
        "statAward": { "type": "string" },
        "statAwardLabel": { "type": "string" },
        "statRecruiter": { "type": "string" },
        "statRecruiterLabel": { "type": "string" },
        "servicesTag": { "type": "string" },
        "servicesTitle": { "type": "string" },
        "servicesSubtitle": { "type": "string" },
        "service1Title": { "type": "string" },
        "service1Desc": { "type": "string" },
        "service1Features": { "type": "string" },
        "service2Title": { "type": "string" },
        "service2Desc": { "type": "string" },
        "service2Features": { "type": "string" },
        "service3Title": { "type": "string" },
        "service3Desc": { "type": "string" },
        "service3Features": { "type": "string" },
        "service4Title": { "type": "string" },
        "service4Desc": { "type": "string" },
        "service4Features": { "type": "string" },
        "cbseTag": { "type": "string" },
        "cbseTitle": { "type": "string" },
        "cbseSubtitle": { "type": "string" },
        "pillar1Title": { "type": "string" },
        "pillar1Desc": { "type": "string" },
        "pillar2Title": { "type": "string" },
        "pillar2Desc": { "type": "string" },
        "pillar3Title": { "type": "string" },
        "pillar3Desc": { "type": "string" },
        "pillar4Title": { "type": "string" },
        "pillar4Desc": { "type": "string" },
        "founderName": { "type": "string" },
        "founderDesignation": { "type": "string" },
        "founderBio": { "type": "string" },
        "founderBadges": { "type": "string" },
        "founderPhone": { "type": "string" },
        "founderEmail": { "type": "string" },
        "founderAddress": { "type": "string" },
        "faq1Q": { "type": "string" },
        "faq1A": { "type": "string" },
        "faq2Q": { "type": "string" },
        "faq2A": { "type": "string" },
        "faq3Q": { "type": "string" },
        "faq3A": { "type": "string" },
        "faq4Q": { "type": "string" },
        "faq4A": { "type": "string" },
        "awardsSectionTag": { "type": "string" },
        "awardsSectionTitle": { "type": "string" },
        "awardsSectionSubtitle": { "type": "string" },
        "awards": { "type": "array" },
        "stagePhotos": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    },
    "AdminUser": {
      "title": "Admin User",
      "description": "Administrator profile with elevated rights",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Inquiry submitted by school leader or visitor",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    },
    "AuditSubmission": {
      "title": "Audit Submission",
      "description": "School self audit submissions and scores",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "score": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolName", "email"]
    },
    "ResumeSubmission": {
      "title": "Resume Submission",
      "description": "Educator and staff resume submissions",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "postApplied": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "postApplied"]
    }
  },
  "firestore": {
    "/site_config/{configId}": {
      "schema": "SiteConfig",
      "description": "Customizable content for portal sections"
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Authorized administrators"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Submitted inquiries from the public portal"
    },
    "/audits/{auditId}": {
      "schema": "AuditSubmission",
      "description": "Submitted school self audits"
    },
    "/resumes/{resumeId}": {
      "schema": "ResumeSubmission",
      "description": "Submitted educator resumes"
    }
  }
}
